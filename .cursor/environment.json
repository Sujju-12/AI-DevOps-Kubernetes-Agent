{
  "name": "AI Kubernetes Agent",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "chmod +x scripts/cloud-agent-install.sh && ./scripts/cloud-agent-install.sh",
  "ports": [3000, 8000],
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && source .venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --hostname 0.0.0.0 --port 3000"
    }
  ]
}
