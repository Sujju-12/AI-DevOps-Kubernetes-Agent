# Host path to kubeconfig (file, not directory). Used by docker compose.
# Linux / WSL:
# KUBECONFIG_HOST_PATH=/home/YOUR_USER/.kube/config
# Windows kubeconfig visible from WSL:
# KUBECONFIG_HOST_PATH=/mnt/c/Users/YOUR_WINDOWS_USER/.kube/config

# Run investigations without a live cluster:
# DEMO_MODE=true
